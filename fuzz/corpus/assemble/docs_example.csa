# greet.csa — 打招呼：抬眉 → 微笑 → 保持 → 复位
.layer          10
.clock          hz = 60
.fuel           4096
.max_wait       600.0

.muscle         brow_l
.muscle         brow_r
.muscle         mouth_corner_l
.muscle         mouth_corner_r
.group          brows   = brow_l, brow_r
.group          corners = mouth_corner_l, mouth_corner_r

.sensor_f       smile
.sensor_f       brow_raise
.sensor_i       gaze_lock

.text
entry:
    ISENSE  i1, gaze_lock
    IJNZ    i1, L_done

    FMOVI   f1, 1.0
    FMOVI   f2, 0.0
    FMOVI   f3, 0.85
    FMOVI   f4, 0.90

    FEXCITE brows, f1
    FLUSH
wait_brow:
    FSENSE  f5, brow_raise
    FGE     f5, f4, L_brow_ok
    YIELD
    JMP     wait_brow
L_brow_ok:

    FEXCITE corners, f1
    FLUSH
wait_smile:
    FSENSE  f5, smile
    FGE     f5, f3, L_smile_ok
    YIELD
    JMP     wait_smile
L_smile_ok:

    WAIT    2.0

    FEXCITE brows, f2
    FEXCITE corners, f2
    FLUSH
    WAIT    0.5
L_done:
    HALT
